# ============================================================
# MINEGUARD — Backend Environment Template
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values (never commit .env to Git)
# ============================================================

PORT=8000

# ── MongoDB ──────────────────────────────────────────────────
# Option A — Local MongoDB (single dev machine):
# MONGODB_URL=mongodb://localhost:27017

# Option B — MongoDB Atlas (shared team / cloud):
# Get your connection string from:
#   Atlas Dashboard → Cluster → Connect → Drivers → Python
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>

DATABASE_NAME=mineguard_db

# ── JWT ──────────────────────────────────────────────────────
# Change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Provider ──────────────────────────────────────────────
# Options: fallback (built-in) | groq | openai
AI_PROVIDER=fallback
GROQ_API_KEY=
OPENAI_API_KEY=
